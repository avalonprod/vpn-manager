TELEGRAM_ACCESS_TOKEN=telegram_bot_token
TELEGRAM_WEBHOOK_TOKEN=your_secret_webhook_token
TELEGRAM_WEBHOOK_PORT=2000

MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=qwerty
MONGODB_NAME=main

API_URL=http://localhost:8000
PORT=8000
APPSTORE_URL=https://apps.apple.com/ru/app/streisand/id6450534064
PLAYMARKET_URL=https://play.google.com/store/search?q=v2raytun&c=apps
SERVER_PANEL_PASSWORD=server_panel_password

CLOUDPAYMENTS_PUBLIC_ID=your_cloudpayments_public_id
CLOUDPAYMENTS_SECRET=your_cloudpayments_secret
CLOUDPAMENTS_API_URL=https://api.cloudpayments.ru

# ============ Админ-панель ============
# Панель включается только когда заданы ADMIN_USERNAME и пароль.
# Без них маршруты /admin/api/v1 не регистрируются вообще.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_long_random_password

# Альтернатива ADMIN_PASSWORD: sha256-хеш пароля в hex. Имеет приоритет над
# ADMIN_PASSWORD и позволяет не держать пароль в открытом виде.
#   printf '%s' 'ваш_пароль' | shasum -a 256
# ADMIN_PASSWORD_SHA256=

# Ключ подписи админских JWT. Минимум 32 символа, иначе сервис не стартует.
#   openssl rand -hex 32
ADMIN_JWT_SECRET=replace_with_openssl_rand_hex_32_output_at_least_32_chars

# Время жизни токена в минутах (по умолчанию 480 = 8 часов).
ADMIN_TOKEN_TTL_MINUTES=480

# Origin'ы, которым разрешён доступ к админскому API (через запятую).
# Указывать обязательно со схемой: сравнение идёт с заголовком Origin целиком,
# поэтому "admin.neonguard.ru" без https:// не совпадёт ни с чем.
ADMIN_CORS_ORIGINS=https://admin.neonguard.ru,http://localhost:5173

# Включайте только если сервис реально стоит за доверенным reverse proxy:
# иначе X-Forwarded-For подделывается и обходит лимиты входа.
ADMIN_TRUST_PROXY=false
